{
  "title": "NOC Overview",
  "uid": "noc-overview",
  "tags": ["noc", "network", "lab", "routing"],
  "schemaVersion": 39,
  "version": 7,
  "editable": true,
  "refresh": "5s",
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "graphTooltip": 1,
  "links": [
    {
      "title": "Prometheus",
      "url": "http://127.0.0.1:9090",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "keepTime": true
    },
    {
      "title": "Alertmanager",
      "url": "http://127.0.0.1:9093",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "keepTime": true
    },
    {
      "title": "Incident Center",
      "url": "http://127.0.0.1:9095",
      "type": "link",
      "icon": "bolt",
      "targetBlank": true,
      "keepTime": false
    }
  ],
  "panels": [
    {
      "id": 10,
      "type": "row",
      "title": "Node Reachability & Routing Adjacencies",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "ICMP Reachability",
      "description": "ICMP probe result per lab node over the management network. Red = unreachable.",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"lab-icmp\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.node}",
          "unit": "short",
          "decimals": 0,
          "noValue": "NO DATA",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "horizontal",
        "wideLayout": true
      }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "OSPF Adjacencies (State = Full)",
      "description": "Active OSPF neighbor adjacency status. 1 = Full (Healthy), 0 = Not Full / Down.",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "frr_ospf_neighbor_state",
          "legendFormat": "{{node}} ➔ {{neighbor}} ({{interface}})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.node} ➔ ${__field.labels.neighbor}",
          "unit": "short",
          "decimals": 0,
          "noValue": "N/A",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "FULL", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "horizontal",
        "wideLayout": true
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Latency, Traffic Throughput & Packet Drops",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "ICMP Round-Trip Time",
      "description": "RTT in milliseconds per node.",
      "gridPos": { "x": 0, "y": 6, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_icmp_duration_seconds{job=\"lab-icmp\",phase=\"rtt\"} * 1000",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 150 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Interface Traffic Throughput (Rx / Tx)",
      "description": "Throughput in bits/second across core and distribution router links.",
      "gridPos": { "x": 8, "y": 6, "w": 10, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node, device) (rate(network_receive_bytes_total{device=~\"eth[0-9]+\"}[30s])) * 8",
          "legendFormat": "{{node}}:{{device}} Rx"
        },
        {
          "refId": "B",
          "expr": "sum by (node, device) (rate(network_transmit_bytes_total{device=~\"eth[0-9]+\"}[30s])) * 8",
          "legendFormat": "{{node}}:{{device}} Tx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Firing Alerts & Incidents",
      "description": "Alerts currently firing in Prometheus, coloured by severity.",
      "gridPos": { "x": 18, "y": 6, "w": 6, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "alertstate": true,
              "job": true
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "instance": "Target",
              "node": "Node"
            },
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "node": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "All systems healthy",
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": { "text": "CRITICAL", "color": "red", "index": 0 },
                      "warning": { "text": "WARNING", "color": "orange", "index": 1 },
                      "info": { "text": "INFO", "color": "blue", "index": 2 }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Router & Lab Logs",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error & Warning Log Rate",
      "description": "Log lines per node containing error/warning keywords.",
      "gridPos": { "x": 0, "y": 16, "w": 16, "h": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (node) (rate({job=\"lab-logs\", lab=\"noc-lab\"} |~ \"(?i)\\\\b(error|err|warning|warn)\\\\b\" [1m])) * 60",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "noValue": "No errors or warnings",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Errors & Warnings by Node",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (node) (count_over_time({job=\"lab-logs\", lab=\"noc-lab\"} |~ \"(?i)\\\\b(error|err|warning|warn)\\\\b\" [$__range])) or on(node) sum by (node) (count_over_time({job=\"lab-logs\", lab=\"noc-lab\"} [$__range])) * 0",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.node}",
          "unit": "short",
          "noValue": "CLEAN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Lab Logs",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{job=\"lab-logs\", lab=\"noc-lab\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": { "noValue": "No logs in selected time range" },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "fontSize": "12px"
      }
    }
  ]
}